# Persistent PostgreSQL URL from Neon, Supabase, Railway, Render, or local PostgreSQL.
# Use the pooled URL for a serverless Vercel deployment when your provider offers one.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Keep small on serverless hosts. Increase carefully for a dedicated Node server.
DB_POOL_MAX=5
APP_VERSION=1.0.0
